#!/usr/bin/env bash
# lsa/hooks/pre-commit — plugin-shipped, portable copy of .githooks/pre-commit
# (rag-plugin-plug-and-play, bootstrap-trigger epic, R5). Same best-effort
# local RAG-index refresh on commit, same "never blocks the commit" contract;
# differs only in HOW it locates its sibling rag-index.sh.
#
# Wired via: git config core.hooksPath <plugin-hooks-dir>  — lsa:bootstrap-rag
# (lsa/scripts/bootstrap-rag.sh) sets this to this plugin's own lsa/hooks/
# directory for a target repo.
#
# core.hooksPath can point at ONE shared plugin-install location serving
# MULTIPLE different target repos on the same machine. Unlike
# .githooks/pre-commit (which only ever runs inside claude-marketplace
# itself and calls its sibling by a hardcoded, root-relative
# "scripts/rag-index.sh" path), this hook must resolve TWO different things
# independently:
#   - where ITS OWN sibling rag-index.sh physically lives (this plugin's own
#     install location) — via ${BASH_SOURCE[0]}, the identical self-location
#     pattern lsa/scripts/check-rag-index-matches-head.sh already uses to
#     find its own sibling rag-index.sh.
#   - which TARGET repo is being committed to — via `git rev-parse
#     --show-toplevel`, which always reflects wherever `git commit` was
#     actually invoked, never the plugin's own install path (R5).
#
# R2 (.lsa/features/rag-context-engine-and-repo-indexing/commit-triggered-sync/
# requirements.md), reused here: this hook is best-effort local convenience,
# NOT the enforcement point (lsa/scripts/check-rag-index-matches-head.sh,
# wired into .lsa.yaml gate: rag-index-matches-head, is). This hook MUST
# NEVER block the commit: any rag-index.sh failure — including Docker being
# unreachable (exit 2, see lsa/scripts/rag-index.sh's exit-code contract) —
# is reported as a warning on stderr and the hook still exits 0.
#
# Opt out: git config --unset core.hooksPath

set -uo pipefail
export LC_ALL=C

# Self-location: this file's own directory is lsa/hooks/; its sibling
# rag-index.sh lives one level up, at lsa/scripts/rag-index.sh — same
# ${BASH_SOURCE[0]}-relative pattern lsa/scripts/check-rag-index-matches-head.sh
# uses for its own sibling call.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
plugin_root="$(cd "${script_dir}/.." && pwd)"
rag_index_script="${plugin_root}/scripts/rag-index.sh"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "${repo_root}" ]] || exit 0
cd "${repo_root}" || exit 0

[[ -x "${rag_index_script}" ]] || exit 0

changed_files="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
[[ -n "${changed_files}" ]] || exit 0

any_failed=0
while IFS= read -r f; do
  [[ -n "${f}" && -f "${f}" ]] || continue
  if ! "${rag_index_script}" "${f}"; then
    any_failed=1
  fi
done <<<"${changed_files}"

if [[ "${any_failed}" -eq 1 ]]; then
  printf 'WARNING: lsa/hooks/pre-commit — the RAG index was not fully updated for this commit (see messages above, e.g. Docker unreachable). This is a best-effort local convenience only; the rag-index-matches-head gate check enforces index freshness independently. Commit proceeding.\n' >&2
fi

exit 0
